#!/bin/bash
# Apply a static image wallpaper using ii's switchwall.sh
wall_path="$1"

if [ -z "$wall_path" ]; then
    echo "Usage: $0 <wallpaper_path>"
    exit 1
fi

# Use ii's wallpaper switching script
switchwall_script="$HOME/.config/quickshell/ii/scripts/colors/switchwall.sh"

if [ -f "$switchwall_script" ]; then
    "$switchwall_script" --image "$wall_path"
else
    echo "Error: switchwall.sh not found at $switchwall_script"
    exit 1
fi
