pragma ComponentBehavior: Bound
import qs
import qs.services
import qs.modules.common
import qs.modules.common.widgets
import qs.modules.common.functions
import Qt5Compat.GraphicalEffects
import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland

Item {
    id: root
    required property var panelWindow
    readonly property HyprlandMonitor monitor: Hyprland.monitorFor(panelWindow.screen)
    readonly property var toplevels: ToplevelManager.toplevels
    readonly property int workspacesShown: Config.options.overview.rows * Config.options.overview.columns
    readonly property int workspaceGroup: Math.floor((monitor.activeWorkspace?.id - 1) / workspacesShown)
    property bool monitorIsFocused: (Hyprland.focusedMonitor?.name == monitor.name)
    property var windows: HyprlandData.windowList
    property var windowByAddress: HyprlandData.windowByAddress
    property var windowAddresses: HyprlandData.addresses
    property var monitorData: HyprlandData.monitors.find(m => m.id === root.monitor?.id)
    property real scale: Config.options.overview.scale

    // ── Palette ──────────────────────────────────────────────────────
    readonly property color c0:  "#0a0b10"
    readonly property color acc: "#40E0D0"
    readonly property color accDim: Qt.rgba(0.25, 0.88, 0.82, 0.22)
    readonly property color accGlow: Qt.rgba(0.25, 0.88, 0.82, 0.08)

    // ── Workspace geometry ──────────────────────────────────────────
    property real workspaceImplicitWidth: (monitorData?.transform % 2 === 1)
        ? ((monitor.height - (monitorData?.reserved[0]??0) - (monitorData?.reserved[2]??0)) * root.scale / monitor.scale)
        : ((monitor.width  - (monitorData?.reserved[0]??0) - (monitorData?.reserved[2]??0)) * root.scale / monitor.scale)
    property real workspaceImplicitHeight: (monitorData?.transform % 2 === 1)
        ? ((monitor.width  - (monitorData?.reserved[1]??0) - (monitorData?.reserved[3]??0)) * root.scale / monitor.scale)
        : ((monitor.height - (monitorData?.reserved[1]??0) - (monitorData?.reserved[3]??0)) * root.scale / monitor.scale)

    property real largeWorkspaceRadius: Appearance.rounding.large
    property real smallWorkspaceRadius: Appearance.rounding.verysmall
    property real workspaceSpacing: 12

    property int workspaceZ:      0
    property int windowZ:         1
    property int windowDraggingZ: 99999

    property int draggingFromWorkspace:   -1
    property int draggingTargetWorkspace: -1

    // ── Active-frame animated position ──────────────────────────────
    // These drive the glowing plasma frame that slides between tiles.
    property real frameX: 0
    property real frameY: 0
    property real frameW: workspaceImplicitWidth
    property real frameH: workspaceImplicitHeight

    function getWsRow(ws) {
        var r = Math.floor((ws-1) / Config.options.overview.columns) % Config.options.overview.rows
        return Config.options.overview.orderBottomUp ? Config.options.overview.rows - r - 1 : r
    }
    function getWsColumn(ws) {
        var c = (ws-1) % Config.options.overview.columns
        return Config.options.overview.orderRightLeft ? Config.options.overview.columns - c - 1 : c
    }
    function getWsInCell(ri, ci) {
        return (Config.options.overview.orderBottomUp ? Config.options.overview.rows - ri - 1 : ri)
               * Config.options.overview.columns
               + (Config.options.overview.orderRightLeft ? Config.options.overview.columns - ci - 1 : ci)
               + 1
    }
    function updateFramePos() {
        var ri = getWsRow(monitor.activeWorkspace?.id ?? 1)
        var ci = getWsColumn(monitor.activeWorkspace?.id ?? 1)
        frameX = (workspaceImplicitWidth  + workspaceSpacing) * ci
        frameY = (workspaceImplicitHeight + workspaceSpacing) * ri
    }
    onMonitorChanged: Qt.callLater(updateFramePos)
    Connections {
        target: root.monitor
        function onActiveWorkspaceChanged() { root.updateFramePos(); burstAnim.restart() }
    }
    Component.onCompleted: Qt.callLater(updateFramePos)

    implicitWidth:  shell.implicitWidth  + Appearance.sizes.elevationMargin * 2
    implicitHeight: shell.implicitHeight + Appearance.sizes.elevationMargin * 2

    property Component windowComponent: OverviewWindow {}
    property list<OverviewWindow> windowWidgets: []

    // ════════════════════════════════════════════════════════════════
    //  PARTICLE FIELD BACKGROUND
    // ════════════════════════════════════════════════════════════════
    Canvas {
        id: particleCanvas
        anchors.fill: shell
        anchors.margins: -Appearance.sizes.elevationMargin
        z: -5
        opacity: GlobalStates.overviewOpen ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 600; easing.type: Easing.OutCubic } }

        property var particles: []
        property real t: 0

        Timer {
            interval: 32
            running: GlobalStates.overviewOpen
            repeat: true
            onTriggered: {
                particleCanvas.t += 0.016
                // Lazy-init 40 particles
                if (particleCanvas.particles.length === 0) {
                    for (var i = 0; i < 40; i++) {
                        particleCanvas.particles.push({
                            x: Math.random() * particleCanvas.width,
                            y: Math.random() * particleCanvas.height,
                            vx: (Math.random() - 0.5) * 0.6,
                            vy: (Math.random() - 0.5) * 0.4,
                            r: Math.random() * 1.6 + 0.4,
                            a: Math.random()
                        })
                    }
                }
                var ps = particleCanvas.particles
                for (var j = 0; j < ps.length; j++) {
                    ps[j].x += ps[j].vx
                    ps[j].y += ps[j].vy
                    if (ps[j].x < 0)   ps[j].x += particleCanvas.width
                    if (ps[j].x > particleCanvas.width)  ps[j].x -= particleCanvas.width
                    if (ps[j].y < 0)   ps[j].y += particleCanvas.height
                    if (ps[j].y > particleCanvas.height) ps[j].y -= particleCanvas.height
                    ps[j].a = 0.35 + 0.25 * Math.sin(particleCanvas.t * 1.4 + j * 0.7)
                }
                particleCanvas.requestPaint()
            }
        }
        onPaint: {
            var ctx = getContext("2d")
            ctx.clearRect(0, 0, width, height)
            var ps = particles
            for (var i = 0; i < ps.length; i++) {
                ctx.beginPath()
                ctx.arc(ps[i].x, ps[i].y, ps[i].r, 0, Math.PI * 2)
                ctx.fillStyle = `rgba(64, 224, 208, ${ps[i].a})`
                ctx.fill()
                // Connect close particles with faint lines
                for (var j = i + 1; j < ps.length; j++) {
                    var dx = ps[i].x - ps[j].x, dy = ps[i].y - ps[j].y
                    var dist = Math.sqrt(dx*dx + dy*dy)
                    if (dist < 80) {
                        ctx.beginPath()
                        ctx.moveTo(ps[i].x, ps[i].y)
                        ctx.lineTo(ps[j].x, ps[j].y)
                        ctx.strokeStyle = `rgba(64,224,208,${0.12 * (1 - dist/80)})`
                        ctx.lineWidth = 0.5
                        ctx.stroke()
                    }
                }
            }
        }
    }

    // ════════════════════════════════════════════════════════════════
    //  OUTER SHELL (glass card)
    // ════════════════════════════════════════════════════════════════
    StyledRectangularShadow { target: shell }

    Rectangle {
        id: shell
        readonly property real pad: 16
        anchors.fill: parent
        anchors.margins: Appearance.sizes.elevationMargin

        implicitWidth:  grid.implicitWidth  + pad * 2
        implicitHeight: grid.implicitHeight + pad * 2

        radius: largeWorkspaceRadius + pad
        color: Qt.rgba(0.04, 0.05, 0.08, 0.92)
        border.width: 1
        border.color: Qt.rgba(1, 1, 1, 0.07)

        // Top rim catch-light
        Rectangle {
            anchors.top: parent.top; anchors.topMargin: 1
            anchors.horizontalCenter: parent.horizontalCenter
            width: parent.width * 0.65; height: 1; radius: 1
            color: Qt.rgba(1, 1, 1, 0.16)
        }

        // ── Workspace tiles ──────────────────────────────────────────
        Column {
            id: grid
            z: root.workspaceZ
            anchors.centerIn: parent
            spacing: root.workspaceSpacing

            Repeater {
                model: Config.options.overview.rows
                delegate: Row {
                    id: wsRow
                    required property int index
                    spacing: root.workspaceSpacing

                    Repeater {
                        model: Config.options.overview.columns
                        delegate: Item {
                            id: tile
                            required property int index
                            property int  col:       index
                            property int  wsVal:     root.workspaceGroup * root.workspacesShown + getWsInCell(wsRow.index, col)
                            property int  tileIdx:   wsRow.index * Config.options.overview.columns + col
                            property bool isActive:  wsVal === root.monitor.activeWorkspace?.id
                            property bool isHovered: hoverArea.containsMouse
                            property bool isDrop:    false

                            property bool atL: col === 0
                            property bool atR: col === Config.options.overview.columns - 1
                            property bool atT: wsRow.index === 0
                            property bool atB: wsRow.index === Config.options.overview.rows - 1

                            implicitWidth:  root.workspaceImplicitWidth
                            implicitHeight: root.workspaceImplicitHeight

                            // ── WARP ENTRANCE: fly in from random directions ──
                            property real enterP: 0
                            opacity: Math.min(enterP * 3, 1)

                            // Random direction offsets burned in per-tile (deterministic from tileIdx)
                            property real warpDX: ((tile.tileIdx * 1619 + 7) % 200 - 100)
                            property real warpDY: ((tile.tileIdx * 2311 + 13) % 200 - 100)

                            transform: [
                                Translate {
                                    x: (1 - tile.enterP) * tile.warpDX
                                    y: (1 - tile.enterP) * tile.warpDY
                                },
                                Scale {
                                    origin.x: tile.width  / 2
                                    origin.y: tile.height / 2
                                    xScale: 0.55 + tile.enterP * 0.45
                                    yScale: 0.55 + tile.enterP * 0.45
                                }
                            ]

                            NumberAnimation on enterP {
                                id: enterAnim
                                running: false
                                from: 0; to: 1
                                duration: 520
                                easing.type: Easing.OutExpo
                            }
                            Connections {
                                target: GlobalStates
                                function onOverviewOpenChanged() {
                                    if (GlobalStates.overviewOpen) {
                                        tile.enterP = 0
                                        warpDelay.restart()
                                    } else {
                                        tile.enterP = 0
                                    }
                                }
                            }
                            Timer {
                                id: warpDelay
                                interval: tile.tileIdx * 55
                                repeat: false
                                onTriggered: enterAnim.start()
                            }

                            // ── Tile body ────────────────────────────
                            Rectangle {
                                id: body
                                anchors.fill: parent
                                topLeftRadius:     (tile.atL && tile.atT) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                                topRightRadius:    (tile.atR && tile.atT) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                                bottomLeftRadius:  (tile.atL && tile.atB) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                                bottomRightRadius: (tile.atR && tile.atB) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius

                                color: tile.isDrop    ? Qt.rgba(0.20, 0.24, 0.28, 0.95)
                                     : tile.isHovered ? Qt.rgba(0.13, 0.15, 0.20, 0.95)
                                     :                  Qt.rgba(0.09, 0.10, 0.13, 0.90)
                                Behavior on color { ColorAnimation { duration: 130 } }

                                border.width: tile.isDrop ? 2 : (tile.isHovered ? 1 : 0)
                                border.color: tile.isDrop    ? root.acc
                                            : tile.isHovered ? Qt.rgba(1,1,1, 0.14)
                                            :                  "transparent"
                                Behavior on border.color { ColorAnimation { duration: 130 } }

                                // Specular top strip
                                Rectangle {
                                    anchors.top: parent.top; anchors.topMargin: 1
                                    anchors.left: parent.left;  anchors.leftMargin:  body.topLeftRadius  * 0.5
                                    anchors.right: parent.right; anchors.rightMargin: body.topRightRadius * 0.5
                                    height: 1; radius: 1
                                    opacity: tile.isActive ? 0.22 : 0.07
                                    color: tile.isActive ? root.acc : "white"
                                    Behavior on opacity { NumberAnimation { duration: 220 } }
                                }
                            }

                            // ── Scanline shimmer on hover ────────────
                            Item {
                                anchors.fill: parent
                                clip: true
                                opacity: tile.isHovered ? 1 : 0
                                Behavior on opacity { NumberAnimation { duration: 200 } }

                                Rectangle {
                                    id: shimmer
                                    width: parent.width * 2.5
                                    height: parent.height
                                    x: -parent.width
                                    color: "transparent"

                                    // Diagonal gloss stripe
                                    Rectangle {
                                        x: parent.width * 0.3
                                        y: -parent.height * 0.3
                                        width: 40
                                        height: parent.height * 2
                                        rotation: 20
                                        color: Qt.rgba(1, 1, 1, 0.04)
                                        radius: 20
                                    }

                                    NumberAnimation on x {
                                        running: tile.isHovered
                                        loops: Animation.Infinite
                                        from: -shimmer.width
                                        to: parent.parent.width
                                        duration: 1600
                                        easing.type: Easing.InOutSine
                                    }
                                }
                            }

                            // ── Workspace number ────────────────────
                            Text {
                                anchors.centerIn: parent
                                text: tile.wsVal
                                font.pixelSize: Math.round(root.workspaceImplicitHeight * 0.52 * root.scale)
                                font.weight: Font.Bold
                                font.family: Appearance.font.family.expressive
                                color: tile.isActive  ? Qt.rgba(0.25, 0.88, 0.82, 0.44)
                                     : tile.isHovered ? Qt.rgba(1, 1, 1, 0.22)
                                     :                  Qt.rgba(1, 1, 1, 0.06)
                                Behavior on color { ColorAnimation { duration: 180 } }
                            }

                            // ── Input ───────────────────────────────
                            MouseArea {
                                id: hoverArea
                                anchors.fill: parent
                                hoverEnabled: true
                                acceptedButtons: Qt.NoButton
                            }
                            MouseArea {
                                anchors.fill: parent
                                acceptedButtons: Qt.LeftButton
                                onPressed: {
                                    if (root.draggingTargetWorkspace === -1) {
                                        GlobalStates.overviewOpen = false
                                        Hyprland.dispatch(`workspace ${tile.wsVal}`)
                                    }
                                }
                            }
                            DropArea {
                                anchors.fill: parent
                                onEntered: {
                                    root.draggingTargetWorkspace = tile.wsVal
                                    if (root.draggingFromWorkspace !== tile.wsVal) tile.isDrop = true
                                }
                                onExited: {
                                    tile.isDrop = false
                                    if (root.draggingTargetWorkspace === tile.wsVal) root.draggingTargetWorkspace = -1
                                }
                            }
                        }
                    }
                }
            }
        } // grid

        // ── Windows layer ──────────────────────────────────────────
        Item {
            id: windowLayer
            anchors.centerIn: parent
            implicitWidth:  grid.implicitWidth
            implicitHeight: grid.implicitHeight

            Repeater {
                model: ScriptModel {
                    values: {
                        return ToplevelManager.toplevels.values.filter(t => {
                            const addr = `0x${t.HyprlandToplevel?.address}`
                            const win  = root.windowByAddress[addr]
                            return (root.workspaceGroup * root.workspacesShown < win?.workspace?.id
                                 && win?.workspace?.id <= (root.workspaceGroup + 1) * root.workspacesShown)
                        })
                    }
                }
                delegate: OverviewWindow {
                    id: win
                    required property var modelData
                    property int monId:  windowData?.monitor
                    property var mon:    HyprlandData.monitors.find(m => m.id === monId)
                    property var addr:   `0x${modelData.HyprlandToplevel.address}`

                    toplevel:      modelData
                    monitorData:   mon
                    scale:         root.scale
                    widgetMonitor: HyprlandData.monitors.find(m => m.id === root.monitor.id)
                    windowData:    root.windowByAddress[addr]

                    property int wsCol: getWsColumn(windowData?.workspace.id)
                    property int wsRow: getWsRow(windowData?.workspace.id)
                    xOffset: (root.workspaceImplicitWidth  + root.workspaceSpacing) * wsCol
                    yOffset: (root.workspaceImplicitHeight + root.workspaceSpacing) * wsRow

                    property real xInWs: Math.max((windowData?.at[0] - (mon?.x ?? 0) - (monitorData?.reserved[0]??0)) * root.scale, 0)
                    property real yInWs: Math.max((windowData?.at[1] - (mon?.y ?? 0) - (monitorData?.reserved[1]??0)) * root.scale, 0)

                    property real minR: Appearance.rounding.small
                    property bool wsL: wsCol === 0
                    property bool wsR: wsCol === Config.options.overview.columns - 1
                    property bool wsT: wsRow === 0
                    property bool wsB: wsRow === Config.options.overview.rows - 1
                    property real dL: xInWs
                    property real dR: root.workspaceImplicitWidth  - (xInWs + targetWindowWidth)
                    property real dT: yInWs
                    property real dB: root.workspaceImplicitHeight - (yInWs + targetWindowHeight)
                    topLeftRadius:     Math.max((wsL && wsT) ? root.largeWorkspaceRadius - Math.max(dL,dT) : root.smallWorkspaceRadius, minR)
                    topRightRadius:    Math.max((wsR && wsT) ? root.largeWorkspaceRadius - Math.max(dR,dT) : root.smallWorkspaceRadius, minR)
                    bottomLeftRadius:  Math.max((wsL && wsB) ? root.largeWorkspaceRadius - Math.max(dL,dB) : root.smallWorkspaceRadius, minR)
                    bottomRightRadius: Math.max((wsR && wsB) ? root.largeWorkspaceRadius - Math.max(dR,dB) : root.smallWorkspaceRadius, minR)

                    z: Drag.active ? root.windowDraggingZ : (root.windowZ + (windowData?.floating ? 1 : 0))
                    Drag.hotSpot.x: width / 2; Drag.hotSpot.y: height / 2

                    Timer {
                        id: resetPos
                        interval: Config.options.hacks.arbitraryRaceConditionDelay
                        repeat: false
                        onTriggered: { win.x = Math.round(xInWs + xOffset); win.y = Math.round(yInWs + yOffset) }
                    }

                    MouseArea {
                        id: winDrag
                        anchors.fill: parent
                        hoverEnabled: true
                        onEntered: win.hovered = true
                        onExited:  win.hovered = false
                        acceptedButtons: Qt.LeftButton | Qt.MiddleButton
                        drag.target: parent
                        onPressed: (mouse) => {
                            root.draggingFromWorkspace = win.windowData?.workspace.id
                            win.pressed = true; win.Drag.active = true; win.Drag.source = win
                            win.Drag.hotSpot.x = mouse.x; win.Drag.hotSpot.y = mouse.y
                        }
                        onReleased: {
                            const tgt = root.draggingTargetWorkspace
                            win.pressed = false; win.Drag.active = false; root.draggingFromWorkspace = -1
                            if (tgt !== -1 && tgt !== win.windowData?.workspace.id) {
                                Hyprland.dispatch(`movetoworkspacesilent ${tgt}, address:${win.windowData?.address}`)
                                resetPos.restart()
                            } else {
                                if (!win.windowData?.floating) { resetPos.restart(); return }
                                const px = Math.round((win.x - xOffset) / root.workspaceImplicitWidth  * 100)
                                const py = Math.round((win.y - yOffset) / root.workspaceImplicitHeight * 100)
                                Hyprland.dispatch(`movewindowpixel exact ${px}% ${py}%, address:${win.windowData?.address}`)
                            }
                        }
                        onClicked: (ev) => {
                            if (!win.windowData) return
                            if (ev.button === Qt.LeftButton) {
                                GlobalStates.overviewOpen = false
                                Hyprland.dispatch(`focuswindow address:${win.windowData.address}`)
                            } else if (ev.button === Qt.MiddleButton) {
                                Hyprland.dispatch(`closewindow address:${win.windowData.address}`)
                            }
                        }
                        StyledToolTip {
                            extraVisibleCondition: false
                            alternativeVisibleCondition: winDrag.containsMouse && !win.Drag.active
                            text: `${win.windowData?.title}\n[${win.windowData?.class}]${win.windowData?.xwayland ? " [XWayland]" : ""}`
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════
            //  PLASMA FRAME — slides between workspaces
            // ══════════════════════════════════════════════════════
            Item {
                id: plasmaFrame
                x: root.frameX
                y: root.frameY
                width:  root.frameW
                height: root.frameH
                z: root.windowZ

                Behavior on x { NumberAnimation { duration: 260; easing.type: Easing.OutExpo } }
                Behavior on y { NumberAnimation { duration: 260; easing.type: Easing.OutExpo } }

                property int ri: getWsRow(root.monitor.activeWorkspace?.id ?? 1)
                property int ci: getWsColumn(root.monitor.activeWorkspace?.id ?? 1)
                property bool pfL: ci === 0
                property bool pfR: ci === Config.options.overview.columns - 1
                property bool pfT: ri === 0
                property bool pfB: ri === Config.options.overview.rows - 1

                // ── Far bloom ──────────────────────────────────────
                Rectangle {
                    anchors.centerIn: parent
                    width: parent.width + 40; height: parent.height + 40
                    radius: root.largeWorkspaceRadius + 20
                    color: "transparent"
                    border.width: 28
                    border.color: Qt.rgba(0.25, 0.88, 0.82, 0.055)
                    z: -3
                }
                // ── Mid glow ring ──────────────────────────────────
                Rectangle {
                    anchors.centerIn: parent
                    width: parent.width + 16; height: parent.height + 16
                    radius: root.largeWorkspaceRadius + 8
                    color: "transparent"
                    border.width: 10
                    border.color: Qt.rgba(0.25, 0.88, 0.82, 0.14)
                    z: -2
                }
                // ── Sharp accent border ────────────────────────────
                Rectangle {
                    anchors.fill: parent
                    color: "transparent"
                    topLeftRadius:     (plasmaFrame.pfL && plasmaFrame.pfT) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                    topRightRadius:    (plasmaFrame.pfR && plasmaFrame.pfT) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                    bottomLeftRadius:  (plasmaFrame.pfL && plasmaFrame.pfB) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                    bottomRightRadius: (plasmaFrame.pfR && plasmaFrame.pfB) ? root.largeWorkspaceRadius : root.smallWorkspaceRadius
                    border.width: 2
                    border.color: root.acc
                    z: -1

                    Behavior on topLeftRadius     { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                    Behavior on topRightRadius    { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                    Behavior on bottomLeftRadius  { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                    Behavior on bottomRightRadius { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }

                    // ── Animated plasma corner sparks ───────────────
                    Repeater {
                        model: 4
                        delegate: Item {
                            id: sparkPair
                            required property int index
                            property real cx: (index === 1 || index === 2) ? parent.width  : 0
                            property real cy: (index === 2 || index === 3) ? parent.height : 0

                            // Big burst dot
                            Rectangle {
                                id: bigSpark
                                width: 8; height: 8; radius: 4
                                color: root.acc
                                x: sparkPair.cx - width  / 2
                                y: sparkPair.cy - height / 2
                                opacity: 0
                                scale: 1

                                SequentialAnimation {
                                    id: bigSparkAnim; running: false
                                    ParallelAnimation {
                                        NumberAnimation { target: bigSpark; property: "opacity"; to: 1.0;  duration: 50 }
                                        NumberAnimation { target: bigSpark; property: "scale";   to: 1.8; duration: 120; easing.type: Easing.OutBack; easing.overshoot: 2 }
                                    }
                                    ParallelAnimation {
                                        NumberAnimation { target: bigSpark; property: "opacity"; to: 0.0; duration: 400; easing.type: Easing.OutCubic }
                                        NumberAnimation { target: bigSpark; property: "scale";   to: 0.2; duration: 400; easing.type: Easing.OutCubic }
                                    }
                                }
                                Connections {
                                    target: root.monitor
                                    function onActiveWorkspaceChanged() { bigSparkAnim.restart() }
                                }
                            }

                            // Trailing orbit dot
                            Rectangle {
                                id: orbitDot
                                width: 3; height: 3; radius: 2
                                color: root.acc
                                opacity: 0
                                property real angle: sparkPair.index * Math.PI / 2
                                property real orbit: 0

                                x: sparkPair.cx + Math.cos(angle + orbit * Math.PI * 2) * 10 - width  / 2
                                y: sparkPair.cy + Math.sin(angle + orbit * Math.PI * 2) * 10 - height / 2

                                SequentialAnimation {
                                    id: orbitAnim; running: false
                                    PauseAnimation { duration: 60 }
                                    ParallelAnimation {
                                        NumberAnimation { target: orbitDot; property: "opacity"; to: 0.75; duration: 80 }
                                        NumberAnimation { target: orbitDot; property: "orbit";   to: 0.5;  duration: 500; easing.type: Easing.OutCubic }
                                    }
                                    NumberAnimation { target: orbitDot; property: "opacity"; to: 0.0; duration: 250; easing.type: Easing.OutCubic }
                                    onStopped: { orbitDot.orbit = 0 }
                                }
                                Connections {
                                    target: root.monitor
                                    function onActiveWorkspaceChanged() { orbitAnim.restart() }
                                }
                            }
                        }
                    }
                }

                // ── Burst ripple that expands outward on switch ─────
                Rectangle {
                    id: burstRing
                    anchors.centerIn: parent
                    width:  parent.width; height: parent.height
                    radius: root.largeWorkspaceRadius
                    color: "transparent"
                    border.width: 2
                    border.color: root.acc
                    opacity: 0
                    scale: 1

                    SequentialAnimation {
                        id: burstAnim; running: false
                        ParallelAnimation {
                            NumberAnimation { target: burstRing; property: "opacity"; to: 0.7;  duration: 40 }
                            NumberAnimation { target: burstRing; property: "scale";   to: 1.0; duration: 1  }
                        }
                        ParallelAnimation {
                            NumberAnimation { target: burstRing; property: "opacity"; to: 0.0; duration: 500; easing.type: Easing.OutCubic }
                            NumberAnimation { target: burstRing; property: "scale";   to: 1.22; duration: 500; easing.type: Easing.OutCubic }
                        }
                    }
                }
            } // plasmaFrame
        } // windowLayer
    } // shell
}
